rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Single-owner workspace: any signed-in user has full access.
    // This app is designed for one owner account. If you later want to
    // support multiple companies/users, tighten this to check request.auth.uid
    // against per-company ownership documents.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
