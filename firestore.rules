rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Single-owner workspace: only the owner's account can read/write.
    // To support multiple users/companies later, replace the fixed UID with
    // a check against per-company ownership documents.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == 'Ue9lt5GHJtgCilERYPPQ8gkFTWr1';
    }
  }
}
